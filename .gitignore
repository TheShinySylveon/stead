# Rebuildable operational state (source of truth = markdown files + schema.sql)
state.db
state.db-wal
state.db-shm

# Rebuildable factory run artifacts (deterministic assembly output)
factories/*/runs/
factories/*/evals/results/

# Python artifacts
__pycache__/
*.pyc
*.pyo

# Deployment secrets. Never commit an access token or a password hash.
stead.json
private/
.env

# One local kill switch. Create with `stead factory stop`.
.stead-stop

# Hallmark redesign records. Not the product.
.hallmark/

# Website working files. Not part of the Stead package.
site/
site.zip

# OS noise
.DS_Store
Thumbs.db
desktop.ini
