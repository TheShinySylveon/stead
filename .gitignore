# Rebuildable operational state (source of truth = markdown files + schema.sql)
state.db
state.db-wal
state.db-shm

# Rebuildable factory run artifacts (deterministic assembly output)
factories/*/runs/
factories/*/evals/results/

# Local checkouts, Python environments, and build output
/.worktrees/
/.venv/
/venv/
/build/
/dist/
*.egg-info/

# Python bytecode and tool caches
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
.coverage.*
/htmlcov/

# Deployment secrets. Never commit an access token or a password hash.
stead.json
private/
.env
.env.*
!.env.example
!.env.sample
!.env.template

# One local kill switch. Create with `stead factory stop`.
.stead-stop

# Local design and website drafts, not shipped with Stead
/.hallmark/
/site/
/site.zip

# OS noise
.DS_Store
Thumbs.db
desktop.ini
